# Virtual environments
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# MLflow tracking store and artefacts -- regenerated by `make train`
mlruns/
mlflow.db
artifacts/

# Raw data -- regenerated and checksum-verified by `python scripts/fetch_data.py`.
# Not committed (6 MB), but exactly reproducible: the SHA-256 of both files is pinned
# in src/mlserve/data/ingest.py and verified on every load.
data/raw/*
!data/raw/.gitkeep
data/processed/
data/scenarios/

# Server logs from benchmark runs -- noise, not evidence
results/**/*.log

# macOS
.DS_Store

# Frontend (Vite/React). Dependencies and build output are reproducible from the lock
# file with `npm ci`, so they are not committed; package-lock.json IS committed so the
# build is deterministic and CI can cache it by lock hash.
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.env.local

# Playwright: reports and traces are artefacts of a run, not sources.
frontend/playwright-report/
frontend/test-results/
frontend/.playwright/
