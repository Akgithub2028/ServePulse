# Backend base URL for the built static site.
#
# Injected at BUILD time by Vite (anything prefixed VITE_ is inlined into the public
# bundle, so nothing secret may ever go here). Render supplies the production value from
# render.yaml; locally, copy this file to `.env.local`.
#
# The deployed site is cross-origin by design: the backend allow-lists this origin via
# MLSERVE_CORS_ORIGINS, so the browser talks to it directly.
VITE_API_BASE_URL=http://127.0.0.1:8077
